# ==============================================================================
# Google Cloud Console OAuth 2.0 Configuration
# ==============================================================================
# In Vercel Project Settings > Environment Variables, you can use:
# Key: GOOGLE_CLIENT_ID
# Value: your_client_id_here.apps.googleusercontent.com

GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Authorized Redirect URI (Callback URL)
GOOGLE_REDIRECT_URI=https://software-srt.vercel.app/auth/callback
