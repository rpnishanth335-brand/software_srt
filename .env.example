# ==========================================
# ChronoForge Firebase Authentication Config
# ==========================================
# 1. Go to Firebase Console: https://console.firebase.google.com/
# 2. Create or select your project.
# 3. Under Build > Authentication > Sign-in method, enable "Google".
# 4. Under Project Settings > General > Your apps, register a Web App and copy the config here.
# 5. In Authentication > Settings > Authorized domains, ensure "localhost" and your Vercel domain are listed.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Feature Flags
# Set to 'true' to allow users to explore ChronoForge as a guest/demo user without signing into Google
VITE_ENABLE_DEMO_LOGIN=true
